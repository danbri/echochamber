{
  "name": "echochamber",
  "private": true,
  "description": "Echoes: RDF library APIs and their test suites over @factoidal/core",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 'conformance/*/*.test.mjs' 'conformance/echo04/*/*.test.mjs' 'packages/*/test/*.test.mjs'",
    "test:echo03": "node --test --test-concurrency=1 'conformance/echo03/*.test.mjs'",
    "test:echo04": "node --test --test-concurrency=1 'conformance/echo04/*/*.test.mjs'"
  },
  "devDependencies": {
    "@factoidal/core": "0.16.0"
  }
}
