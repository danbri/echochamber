{
  "name": "echochamber",
  "private": true,
  "description": "Echoes: RDF library APIs and their test suites over @factoidal/core",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "node --test --test-concurrency=1 'conformance/*/*.test.mjs' 'conformance/moonforge/*/*.test.mjs' 'conformance/leana/*/*/*.test.mjs' 'packages/*/test/*.test.mjs'",
    "test:enthie": "node --test --test-concurrency=1 'conformance/enthie/*.test.mjs'",
    "test:moonforge": "node --test --test-concurrency=1 'conformance/moonforge/*/*.test.mjs'",
    "test:leana": "node --test 'conformance/leana/**/*.test.mjs'",
    "count:leana": "node conformance/leana/count.mjs"
  },
  "devDependencies": {
    "@factoidal/core": "0.18.0"
  }
}
